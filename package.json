{
  "name": "task-management-system-root",
  "version": "1.0.0",
  "private": true,
  "description": "Full-Stack Task Management System",
  "scripts": {
    "postinstall": "npm install --prefix backend && npm install --prefix frontend",
    "install:all": "npm install && npm run postinstall",
    "build:frontend": "npm run build --prefix frontend",
    "build": "npm run build:frontend",
    "start:backend": "npm start --prefix backend",
    "start": "node backend/src/server.js",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "test:backend": "npm test --prefix backend",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\""
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
