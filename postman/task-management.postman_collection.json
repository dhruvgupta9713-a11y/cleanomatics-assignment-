            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/tasks?status=in_progress&priority=high&sortBy=dueDate&sortOrder=asc&page=1&limit=5",
          "host": ["{{baseUrl}}"],
          "path": ["tasks"],
          "query": [
            { "key": "status", "value": "in_progress" },
            { "key": "priority", "value": "high" },
            { "key": "sortBy", "value": "dueDate" },
            { "key": "sortOrder", "value": "asc" },
            { "key": "page", "value": "1" },
            { "key": "limit", "value": "5" }
          ]
        },
        "description": "Fetch tasks with query params for search, status, priority, sorting, and pagination."
