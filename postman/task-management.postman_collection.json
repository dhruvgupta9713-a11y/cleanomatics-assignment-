              "});",
              "pm.test('Response format contains data array', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.eql(true);",
              "    pm.expect(Array.isArray(jsonData.data)).to.eql(true);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
